with "gtkada";
project Debug_Test is
   for Source_Dirs use (".", "../src");
   for Object_Dir use "../obj/tests_dbg";
   for Exec_Dir use "../bin";
   for Main use ("debug_test.adb", "sprite_test.adb", "charset_test.adb",
                     "screen_test.adb", "bitmap_test.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2012", "-g");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-lpulse-simple", "-lpulse",
                                        "-l:libgtksourceview-4.so.0");
   end Linker;
end Debug_Test;
