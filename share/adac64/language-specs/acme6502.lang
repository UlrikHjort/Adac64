<?xml version="1.0" encoding="UTF-8"?>
<!-- 6502 assembly, ACME dialect (AdaC64 Forge) -->
<language id="acme6502" name="6502 Assembly (ACME)" version="2.0" _section="Source">
  <metadata>
    <property name="globs">*.asm;*.a;*.s;*.a65;*.src;*.inc</property>
    <property name="line-comment-start">;</property>
  </metadata>
  <styles>
    <style id="comment"   name="Comment"        map-to="def:comment"/>
    <style id="string"    name="String"         map-to="def:string"/>
    <style id="mnemonic"  name="Mnemonic"       map-to="def:keyword"/>
    <style id="illegal"   name="Illegal opcode" map-to="def:warning"/>
    <style id="directive" name="Directive"      map-to="def:preprocessor"/>
    <style id="number"    name="Number"         map-to="def:number"/>
    <style id="label"     name="Label"          map-to="def:function"/>
    <style id="register"  name="Index register" map-to="def:type"/>
    <style id="macro"     name="Macro call"     map-to="def:special-char"/>
  </styles>
  <default-regex-options case-sensitive="false"/>
  <definitions>
    <context id="acme6502">
      <include>
        <context id="comment" style-ref="comment" end-at-line-end="true">
          <start>;</start>
        </context>
        <context id="string" style-ref="string" end-at-line-end="true">
          <start>"</start>
          <end>"</end>
        </context>
        <context id="char" style-ref="string">
          <match>'.'</match>
        </context>
        <context id="directive" style-ref="directive">
          <match>(![a-z0-9]+|\.(byte|db|word|dw|text|fill|align|org|include|incbin|res|binary|pet|screen|addr)\b|\*\s*=)</match>
        </context>
        <context id="macro" style-ref="macro">
          <match>\+[a-z_][a-z0-9_]*</match>
        </context>
        <context id="mnemonic" style-ref="mnemonic">
          <keyword>adc</keyword>
          <keyword>and</keyword>
          <keyword>asl</keyword>
          <keyword>bcc</keyword>
          <keyword>bcs</keyword>
          <keyword>beq</keyword>
          <keyword>bit</keyword>
          <keyword>bmi</keyword>
          <keyword>bne</keyword>
          <keyword>bpl</keyword>
          <keyword>brk</keyword>
          <keyword>bvc</keyword>
          <keyword>bvs</keyword>
          <keyword>clc</keyword>
          <keyword>cld</keyword>
          <keyword>cli</keyword>
          <keyword>clv</keyword>
          <keyword>cmp</keyword>
          <keyword>cpx</keyword>
          <keyword>cpy</keyword>
          <keyword>dec</keyword>
          <keyword>dex</keyword>
          <keyword>dey</keyword>
          <keyword>eor</keyword>
          <keyword>inc</keyword>
          <keyword>inx</keyword>
          <keyword>iny</keyword>
          <keyword>jmp</keyword>
          <keyword>jsr</keyword>
          <keyword>lda</keyword>
          <keyword>ldx</keyword>
          <keyword>ldy</keyword>
          <keyword>lsr</keyword>
          <keyword>nop</keyword>
          <keyword>ora</keyword>
          <keyword>pha</keyword>
          <keyword>php</keyword>
          <keyword>pla</keyword>
          <keyword>plp</keyword>
          <keyword>rol</keyword>
          <keyword>ror</keyword>
          <keyword>rti</keyword>
          <keyword>rts</keyword>
          <keyword>sbc</keyword>
          <keyword>sec</keyword>
          <keyword>sed</keyword>
          <keyword>sei</keyword>
          <keyword>sta</keyword>
          <keyword>stx</keyword>
          <keyword>sty</keyword>
          <keyword>tax</keyword>
          <keyword>tay</keyword>
          <keyword>tsx</keyword>
          <keyword>txa</keyword>
          <keyword>txs</keyword>
          <keyword>tya</keyword>
        </context>
        <context id="illegal" style-ref="illegal">
          <keyword>slo</keyword>
          <keyword>rla</keyword>
          <keyword>sre</keyword>
          <keyword>rra</keyword>
          <keyword>sax</keyword>
          <keyword>lax</keyword>
          <keyword>dcp</keyword>
          <keyword>isc</keyword>
          <keyword>anc</keyword>
          <keyword>alr</keyword>
          <keyword>arr</keyword>
          <keyword>ane</keyword>
          <keyword>lxa</keyword>
          <keyword>sbx</keyword>
          <keyword>sha</keyword>
          <keyword>shx</keyword>
          <keyword>shy</keyword>
          <keyword>tas</keyword>
          <keyword>las</keyword>
          <keyword>jam</keyword>
          <keyword>isb</keyword>
          <keyword>dcm</keyword>
          <keyword>asr</keyword>
          <keyword>axs</keyword>
          <keyword>lse</keyword>
          <keyword>kil</keyword>
          <keyword>xaa</keyword>
        </context>
        <context id="number" style-ref="number">
          <match>(\$[0-9a-f]+|%[01.#]+|\b0x[0-9a-f]+\b|\b[0-9]+\b)</match>
        </context>
        <context id="register" style-ref="register">
          <match>,\s*[xy]\b</match>
        </context>
        <context id="label" style-ref="label">
          <match>^[a-z_.@][a-z0-9_]*:?</match>
        </context>
      </include>
    </context>
  </definitions>
</language>
